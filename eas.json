{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      },
      "node": "22.14.0"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "ios": {
        "image": "latest"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "android": { "buildType": "apk" }
    },
    "production-simulator": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "ios": { "simulator": true }
    }
  },
  "submit": {
    "production": {}
  }
}
